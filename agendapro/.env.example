# Copie para .env (gitignored). Mesmo projeto Supabase do site (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://ggwppcbdnemjuddnzbdw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Backend (as mesmas APIs do site). Default: produção.
EXPO_PUBLIC_API_BASE=https://brasilconnectusa.com

# Assinatura no app, por plataforma: 'companion' (padrão nas lojas: sem preço,
# sem botão de compra; assina-se no site) ou 'link' (abre o checkout do Stripe).
# Só use 'link' depois de confirmar com a revisão da Apple/Google.
EXPO_PUBLIC_PURCHASE_MODE_IOS=companion
EXPO_PUBLIC_PURCHASE_MODE_ANDROID=companion

# Projeto do EAS (preenchido por `eas init`). Sem ele não sai token de push.
# EAS_PROJECT_ID=
